# ---- Required ----
# Public address people use. Must match DOMAIN (https:// on a real server).
APP_URL=https://work.segdigital.com
DOMAIN=work.segdigital.com
# Long random password for the database (letters and numbers only is simplest).
POSTGRES_PASSWORD=change-this-to-a-long-random-string

# First admin, created on first start. Change the password after your first sign-in.
ADMIN_EMAIL=you@segdigital.com
ADMIN_PASSWORD=choose-a-strong-password
ADMIN_NAME=Your Name

# ---- Email (password resets, invites, approvals, notifications) ----
# Works with Gmail (App Password), Zoho, Brevo, Mailgun, Amazon SES and others.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=you@segdigital.com
SMTP_PASS=your-app-password
MAIL_FROM=SEG Workspace <you@segdigital.com>

# ---- Optional ----
# Only allow self sign-up from this email domain (leave empty to allow any).
ALLOWED_EMAIL_DOMAIN=
# Time zone used for "due today" and "overdue".
APP_TIMEZONE=Asia/Dhaka
# Max upload size per file in MB (keep under the 60 MB limit in deploy/Caddyfile).
MAX_UPLOAD_MB=25
# Days a sign-in lasts without activity.
SESSION_DAYS=30
